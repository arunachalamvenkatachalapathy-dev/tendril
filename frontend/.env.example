# Copy to .env.local for local dev. These Firebase values are PUBLIC
# identifiers (see the note in src/firebase.js) — safe to be in the client
# bundle. The Gemini API key must NEVER appear anywhere in this folder.

VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Your Cloud Run backend URL
VITE_API_BASE_URL=http://localhost:8080
