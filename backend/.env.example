# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit the real .env file
# (it's already in .gitignore). In production (Cloud Run), set these as
# plain env vars via `gcloud run deploy --set-env-vars` — NOT the Gemini
# API key itself, which always comes from Secret Manager at runtime.

# GCP project that owns the Secret Manager secret. Not a secret itself.
GCP_PROJECT_ID=your-gcp-project-id

# Name of the Secret Manager secret holding the Gemini API key.
GEMINI_SECRET_NAME=GEMINI_API_KEY

# Comma-separated list of allowed frontend origins for CORS.
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.web.app

# For LOCAL DEV ONLY, if you don't want to hit Secret Manager while
# developing: point GOOGLE_APPLICATION_CREDENTIALS at a local service
# account key file that is gitignored and never committed, OR run
# `gcloud auth application-default login` so Application Default
# Credentials work without any key file at all (preferred).

# --- Voice (Article 8) ---
# gemini-2.0-flash-live-001 was retired when Gemini 2.0 Flash shut down
# (June 1, 2026). Current as of this build: gemini-3.1-flash-live-preview
# (successor to gemini-2.5-flash-native-audio-preview-12-2025). This API
# moves fast — re-check https://ai.google.dev/gemini-api/docs/live-api
# before your demo.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# --- Scheduled memory compaction (Article 9) ---
# The exact HTTPS URL of this Cloud Run service's /internal/* routes, used
# as the OIDC audience Cloud Scheduler's token must match.
SCHEDULER_AUDIENCE=https://your-cloud-run-url.a.run.app
# The dedicated service account Cloud Scheduler invokes with — must NOT be
# a broadly-privileged account. See DEPLOY.md for the exact gcloud commands.
SCHEDULER_SERVICE_ACCOUNT=scheduler-invoker@your-gcp-project-id.iam.gserviceaccount.com
